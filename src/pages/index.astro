---
import '../styles/global.css';
import pugs from '../data/pugs.json';

const base = import.meta.env.BASE_URL;
const count = Math.max(0, Math.round(Number(pugs.count ?? 0)));
const PAD = 7;
const padded = String(count).padStart(PAD, '0');
const noun = count === 1 ? 'PUG' : 'PUGS';

const checked = pugs.checkedAt ? new Date(pugs.checkedAt) : null;
let updatedStr = 'unknown';
if (checked && !Number.isNaN(checked.valueOf())) {
  updatedStr =
    new Intl.DateTimeFormat('en-US', {
      month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
      timeZone: 'America/New_York',
    }).format(checked) + ' ET';
}

const SITE_TITLE = `Rex currently has ${count} ${count === 1 ? 'pug' : 'pugs'}`;
const SITE_DESC = `The official, auto-updating tally of how many pugs Rex has at this very moment: ${count}.`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`${base}og.png`, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={SITE_DESC} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{SITE_TITLE}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=VT323&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESC} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={SITE_TITLE} />
    <meta name="twitter:description" content={SITE_DESC} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <div class="scene">
      <div class="stars" aria-hidden="true"></div>
      <div class="bg-sun" aria-hidden="true"></div>
      <div class="floor" aria-hidden="true"></div>
      <div class="bg-grid" aria-hidden="true"></div>

      <!-- palms -->
      <svg class="palm palm--l" viewBox="0 0 120 200" aria-hidden="true">
        <g fill="#0a0612">
          <path d="M78,72 C52,50 26,52 4,68 C30,60 56,62 80,80 Z"/>
          <path d="M78,72 C60,40 36,30 18,28 C44,40 64,56 80,80 Z"/>
          <path d="M78,72 C74,40 66,16 54,4 C66,34 74,54 80,80 Z"/>
          <path d="M78,72 C82,38 96,18 114,10 C98,36 86,56 80,80 Z"/>
          <path d="M78,72 C96,46 118,46 120,50 C104,54 90,64 80,80 Z"/>
          <path d="M78,72 C90,54 110,60 120,76 C102,70 86,70 80,80 Z"/>
          <circle cx="72" cy="80" r="5"/><circle cx="84" cy="82" r="4.5"/>
          <path d="M74,80 C70,122 74,162 80,200 L92,200 C84,162 82,122 86,80 Z"/>
        </g>
      </svg>
      <svg class="palm palm--r" viewBox="0 0 120 200" aria-hidden="true">
        <g fill="#0a0612">
          <path d="M78,72 C52,50 26,52 4,68 C30,60 56,62 80,80 Z"/>
          <path d="M78,72 C60,40 36,30 18,28 C44,40 64,56 80,80 Z"/>
          <path d="M78,72 C74,40 66,16 54,4 C66,34 74,54 80,80 Z"/>
          <path d="M78,72 C82,38 96,18 114,10 C98,36 86,56 80,80 Z"/>
          <path d="M78,72 C96,46 118,46 120,50 C104,54 90,64 80,80 Z"/>
          <path d="M78,72 C90,54 110,60 120,76 C102,70 86,70 80,80 Z"/>
          <circle cx="72" cy="80" r="5"/><circle cx="84" cy="82" r="4.5"/>
          <path d="M74,80 C70,122 74,162 80,200 L92,200 C84,162 82,122 86,80 Z"/>
        </g>
      </svg>

      <main class="hud">
        <p class="kicker">Official Pug Census</p>

        <svg class="pug" viewBox="0 0 200 175" role="img" aria-label="A pug wearing neon sunglasses">
          <ellipse cx="52" cy="56" rx="18" ry="27" fill="#3a2f2a" transform="rotate(-22 52 56)"/>
          <ellipse cx="148" cy="56" rx="18" ry="27" fill="#3a2f2a" transform="rotate(22 148 56)"/>
          <ellipse cx="100" cy="92" rx="53" ry="51" fill="#e7b277"/>
          <path d="M82,64 Q100,56 118,64" fill="none" stroke="#cc9658" stroke-width="3" stroke-linecap="round"/>
          <path d="M86,73 Q100,67 114,73" fill="none" stroke="#cc9658" stroke-width="3" stroke-linecap="round"/>
          <ellipse cx="100" cy="120" rx="27" ry="21" fill="#3a2f2a"/>
          <ellipse cx="100" cy="143" rx="8" ry="10" fill="#ef7a98"/>
          <ellipse cx="100" cy="110" rx="9" ry="6.5" fill="#15100c"/>
          <!-- neon sunglasses -->
          <rect x="50" y="80" width="42" height="27" rx="9" fill="#0b0b16" stroke="#00e5ff" stroke-width="3"/>
          <rect x="108" y="80" width="42" height="27" rx="9" fill="#0b0b16" stroke="#ff2e88" stroke-width="3"/>
          <path d="M92,90 H108" stroke="#f5f5f5" stroke-width="4" stroke-linecap="round"/>
          <path d="M57,87 L69,87" stroke="rgba(255,255,255,.55)" stroke-width="3" stroke-linecap="round"/>
          <path d="M115,87 L127,87" stroke="rgba(255,255,255,.55)" stroke-width="3" stroke-linecap="round"/>
        </svg>

        <h1 class="rex">Rex currently has</h1>

        <div class="counter" data-count={count} data-pad={PAD}>
          {padded.split('').map((d) => <span class="cell">{d}</span>)}
        </div>

        <p class="noun">
          {noun}
          {count === 0 && <span class="zero-note">…the search continues</span>}
        </p>

        <p class="synced"><span class="live">●</span> LIVE · synced {updatedStr}</p>
      </main>

      <p class="foot">Auto-updates hourly from Rex HQ · pug count certified ✓</p>
      <div class="scanlines" aria-hidden="true"></div>
    </div>

    <script>
      const counter = document.querySelector('.counter') as HTMLElement | null;
      if (counter) {
        const target = Number(counter.dataset.count);
        const pad = Number(counter.dataset.pad);
        const cells = Array.from(counter.querySelectorAll('.cell'));
        const render = (n: number) => {
          const s = String(n).padStart(pad, '0').slice(-pad);
          cells.forEach((c, i) => (c.textContent = s[i]));
        };
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce && target > 0) {
          const dur = 1300;
          const t0 = performance.now();
          render(0);
          const frame = (t: number) => {
            const p = Math.min(1, (t - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            render(Math.round(eased * target));
            if (p < 1) requestAnimationFrame(frame);
            else { render(target); counter.classList.add('pop'); }
          };
          requestAnimationFrame(frame);
        }
      }
    </script>
  </body>
</html>
